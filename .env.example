PORT=4317

# Point Mate at an official DeepTutor backend.
# Leave DEEPTUTOR_BASE_URL empty to keep Mate in local mock mode.
# Example: http://127.0.0.1:8001
DEEPTUTOR_BASE_URL=
DEEPTUTOR_API_PREFIX=/api/v1
DEEPTUTOR_ROOT_PROBE_PATH=/
DEEPTUTOR_REQUEST_TIMEOUT_MS=180000

# Official DeepTutor websocket routes used by Mate's BFF.
DEEPTUTOR_CHAT_WS_PATH=/api/v1/chat
DEEPTUTOR_SOLVE_WS_PATH=/api/v1/solve
DEEPTUTOR_QUIZ_WS_PATH=/api/v1/question/generate

# Official DeepTutor knowledge-base routes used by Mate's BFF.
DEEPTUTOR_KB_LIST_PATH=/api/v1/knowledge/list
DEEPTUTOR_KB_DEFAULT_PATH=/api/v1/knowledge/default
DEEPTUTOR_KB_SET_DEFAULT_TEMPLATE=/api/v1/knowledge/default/{kb_name}
DEEPTUTOR_KB_CREATE_PATH=/api/v1/knowledge/create
DEEPTUTOR_KB_UPLOAD_TEMPLATE=/api/v1/knowledge/{kb_name}/upload
DEEPTUTOR_DEFAULT_KB_NAME=mate-english
DEEPTUTOR_ENABLE_KB_PROXY=true
DEEPTUTOR_KB_PROVIDER=

# Mate-side defaults when calling DeepTutor.
# Set this to false if your DeepTutor instance does not have a working embedding provider yet.
DEEPTUTOR_ENABLE_RAG=true
DEEPTUTOR_ENABLE_WEB_SEARCH=false
